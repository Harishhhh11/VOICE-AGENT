APP_NAME=VOICE-AGENT
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=auto

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=5
DATABASE_URL=sqlite:///./voice_agent.db
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

TTS_PROVIDER=piper
# Local Piper voice models. Keep the .onnx and matching .onnx.json files together.
TTS_VOICE_EN=./models/tts/en/en_US-lessac-medium.onnx
TTS_VOICE_HI=./models/tts/hi/hi_IN-priyamvada-medium.onnx
TTS_VOICE_TE=./models/tts/te/te_IN-padmavathi-medium.onnx
TTS_LANGUAGE=auto
AUDIO_OUTPUT_DIR=./data/audio
MAX_AUDIO_MB=15

MAX_HISTORY_TURNS=12
CONFIDENCE_THRESHOLD=0.55
ENABLE_LEAD_CAPTURE=true
